<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{DEAF4438-8089-40ED-8175-398E1261D45B}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>QuickPing</RootNamespace>
    <AssemblyName>QuickPing</AssemblyName>
    <TargetFrameworkVersion>v4.8.1</TargetFrameworkVersion>
    <LangVersion>9.0</LangVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>false</Deterministic>
    <NuGetPackageImportStamp>
    </NuGetPackageImportStamp>
    <TargetFrameworkProfile />
    <!-- GitVersionInformation.g.cs needs ExcludeFromCodeCoverage, missing from the Unity corlib references -->
    <GenerateGitVersionInformation>false</GenerateGitVersionInformation>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateSerializationAssemblies>Auto</GenerateSerializationAssemblies>
    <RunCodeAnalysis>false</RunCodeAnalysis>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>
    </DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <StartAction>Program</StartAction>
    <StartProgram>$(VALHEIM_INSTALL)\valheim.exe</StartProgram>
    <StartArguments>-console</StartArguments>
    <StartWorkingDirectory>$(VALHEIM_INSTALL)</StartWorkingDirectory>
  </PropertyGroup>
  <PropertyGroup>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <PropertyGroup>
    <Company>Atopy</Company>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>
    </ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup>
    <StartupObject />
  </PropertyGroup>
  <PropertyGroup>
    <PostBuildEvent>
    </PostBuildEvent>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Patches\Chat.cs" />
    <Compile Include="Patches\Localization.cs" />
    <Compile Include="Patches\IDestructible.cs" />
    <Compile Include="Patches\Minimap.cs" />
    <Compile Include="Patches\Player.cs" />
    <Compile Include="Patches\SaveCollection.cs" />
    <Compile Include="Patches\Terminal.cs" />
    <Compile Include="Patches\ZNet.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Properties\IgnoreAccessModifiers.cs" />
    <Compile Include="QuickPing.cs" />
    <Compile Include="Settings.cs" />
    <Compile Include="Tests\AutoRun.cs" />
    <Compile Include="Tests\InGameTests.cs" />
    <Compile Include="Tests\TestRunner.cs" />
    <Compile Include="Utilities\DataManager.cs" />
    <Compile Include="Utilities\DevDump.cs" />
    <Compile Include="Utilities\GameUI.cs" />
    <Compile Include="Utilities\InputBlocker.cs" />
    <Compile Include="Utilities\Utils.cs" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Package\plugins\" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Package\manifest.json" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Package\icon.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BepInEx.BaseLib">
      <Version>5.4.21</Version>
    </PackageReference>
    <!-- Stay on 5.x: GitVersion 6 disables itself under Visual Studio / msbuild.exe (.NET Framework MSBuild) -->
    <PackageReference Include="GitVersion.MsBuild">
      <Version>5.12.0</Version>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="HarmonyX">
      <Version>2.16.1</Version>
    </PackageReference>
    <PackageReference Include="MonoMod.Backports">
      <Version>1.1.2</Version>
    </PackageReference>
    <PackageReference Include="MonoMod.ILHelpers">
      <Version>1.1.0</Version>
    </PackageReference>
  </ItemGroup>
  <!-- Published (publicized) game and Unity references, so builds don't need a Valheim install.
       Keep these in sync with the game version. -->
  <ItemGroup>
    <PackageReference Include="Digitalroot.Valheim.Common.References">
      <Version>1.0.21</Version>
    </PackageReference>
    <PackageReference Include="Digitalroot.References.Unity">
      <Version>6000.0.75</Version>
    </PackageReference>
    <!-- .NET Framework 4.8.1 reference assemblies, whatever the runner has installed -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies">
      <Version>1.0.3</Version>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Only for Splatform.dll (not in the Digitalroot packages; identical API to the game's) -->
    <PackageReference Include="Pfhoenix.Valheim.ModProjectReferences">
      <Version>1.0.26</Version>
      <ExcludeAssets>all</ExcludeAssets>
    </PackageReference>
    <Reference Include="Splatform">
      <HintPath>$(NuGetPackageRoot)pfhoenix.valheim.modprojectreferences\1.0.26\lib\net46\Splatform.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Target Name="GetAssemblyVersion" AfterTargets="Build">
    <GetAssemblyIdentity AssemblyFiles="$(TargetPath)">
      <Output TaskParameter="Assemblies" ItemName="Targets" />
    </GetAssemblyIdentity>
    <ItemGroup>
      <AssemblyVersions Include="@(Targets->'%(Version)')" />
    </ItemGroup>
    <PropertyGroup>
      <AssemblyVersion>%(AssemblyVersions.Identity)</AssemblyVersion>
      <Major>$(AssemblyVersion.Split('.')[0])</Major>
      <Minor>$(AssemblyVersion.Split('.')[1])</Minor>
      <Patch>$(AssemblyVersion.Split('.')[2])</Patch>
      <Version>$(Major).$(Minor).$(Patch)</Version>
      <PackageName>$(AssemblyName)</PackageName>
      <PackageDir>Package\</PackageDir>
    </PropertyGroup>
  </Target>
  <!-- Import Environment.props-->
  <Import Project="../Environment.Props" Condition="Exists('../Environment.Props')" />
  <Target Name="MakeThunderstorePackage">
    <MakeDir Directories="$(PackageDir)" />
    <MakeDir Directories="$(PackageDir)\plugins\" />
    <Exec command="PowerShell -ExecutionPolicy RemoteSigned -File $(SolutionDir)version.ps1 -PackageDir $(PackageDir) -AssemblyVersion $(Major).$(Minor).$(Patch) " />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).dll" DestinationFiles="$(PackageDir)plugins/$(AssemblyName).dll" />
    <Copy SourceFiles="../README.md" DestinationFiles="$(PackageDir)README.md" />
    <Message Text="Package created at $(AssemblyName).zip" Importance="high" />
    <ZipDirectory SourceDirectory="$(PackageDir)" DestinationFile="$(AssemblyName).zip" Overwrite="true" />
  </Target>
  <!-- Local deploy to the Valheim plugins folder; skipped when VALHEIM_INSTALL is not set (CI) -->
  <Target Name="DeployToValheim" Condition="'$(OS)' == 'Windows_NT' And '$(VALHEIM_INSTALL)' != ''">
    <Exec Command="powershell.exe -ExecutionPolicy RemoteSigned -File &quot;$(SolutionDir)publish.ps1&quot; -Target &quot;$(ConfigurationName)&quot; -TargetPath &quot;$(TargetDir.TrimEnd('\'))&quot; -TargetAssembly &quot;$(TargetFileName)&quot; -ValheimPath &quot;$(VALHEIM_INSTALL.TrimEnd('\'))&quot; -DeployPath &quot;$(MOD_DEPLOYPATH.TrimEnd('\'))&quot; -ProjectPath &quot;$(ProjectDir.TrimEnd('\'))&quot; " />
  </Target>
  <!-- Generates MyPluginInfo (GUID/name/version). Runs after GitVersion so the version is known at compile time;
       GitVersion also writes the assembly version (UpdateAssemblyInfo). -->
  <Target Name="AddGeneratedFile" BeforeTargets="BeforeCompile;CoreCompile" DependsOnTargets="GetVersion">
    <PropertyGroup>
      <BepInExPluginGuid Condition="'$(BepInExPluginGuid)' == ''">com.$(Company.ToLower()).plugins.$(AssemblyName.ToLower())</BepInExPluginGuid>
      <BepInExPluginName Condition="'$(BepInExPluginName)' == ''">$(AssemblyName)</BepInExPluginName>
      <BepInExPluginVersion Condition="'$(BepInExPluginVersion)' == ''">$(GitVersion_MajorMinorPatch)</BepInExPluginVersion>
      <GeneratedText>
namespace $(RootNamespace)
{
    public static class MyPluginInfo
    {
        public const string PLUGIN_GUID = "$(BepInExPluginGuid)"%3B
        public const string PLUGIN_NAME = "$(BepInExPluginName)"%3B
        public const string PLUGIN_VERSION = "$(BepInExPluginVersion)"%3B
    }
}
      </GeneratedText>
      <GeneratedFilePath>$(IntermediateOutputPath)MyPluginInfo.cs</GeneratedFilePath>
    </PropertyGroup>
    <ItemGroup>
      <Compile Include="$(GeneratedFilePath)" />
      <FileWrites Include="$(GeneratedFilePath)" />
    </ItemGroup>
    <WriteLinesToFile Lines="$(GeneratedText)" File="$(GeneratedFilePath)" WriteOnlyWhenDifferent="true" Overwrite="true" />
  </Target>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <BuildDependsOn>
		$(BuildDependsOn);
		GetAssemblyVersion;
		MakeThunderstorePackage;
	</BuildDependsOn>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <BuildDependsOn>
		$(BuildDependsOn);
		GetAssemblyVersion;
		DeployToValheim;
	</BuildDependsOn>
  </PropertyGroup>
</Project>